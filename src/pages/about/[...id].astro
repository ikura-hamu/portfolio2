---
import { getPortfolioGraph } from "@/lib/portfolioContent";
import { Image } from "astro:assets";
import { replaceURL } from "@/util/url";
import { Icon } from "astro-icon/components";
import Layout from "../../layouts/BlogPost.astro";
import PortfolioGraph from "../../components/PortfolioGraph.astro";
import WorkLinks from "../../components/WorkLinks.astro";
import { neighborhood, portfolioUrl } from "../../lib/portfolioGraph";

export async function getStaticPaths() {
  const { nodes: items, relations } = await getPortfolioGraph();
  return items.map((item) => ({
    params: { id: item.id },
    props: { item, graph: neighborhood(items, relations, item.id) },
  }));
}
const { item, graph } = Astro.props;
const section = {
  skills: "Skills",
  products: "Products",
  slides: "Slides",
  tags: "Relations",
}[item.data.category];
const neighbors = graph.nodes.filter(({ id }) => graph.distance.get(id) === 1);
---

<Layout
  title={item.data.title}
  description={item.data.description.replace(/<[^>]*>/g, " ")}
>
  <div class="flex flex-col gap-s5">
    <a href={`/about/#${section}`}>
      ← About Me / {item.data.category === "tags" ? "関連グラフ" : section}
    </a>
    <div class="flex items-center gap-s4">
      {item.data.category === "skills" && (
        <Icon name={item.data.icon} size={72} />
      )}
      <div>
        {item.data.subtitle && <p class="text-sm">{item.data.subtitle}</p>}
        <p set:html={replaceURL(item.data.description)} />
      </div>
    </div>
    {item.data.heroImageContent ? (
      <Image
        src={item.data.heroImageContent}
        alt=""
        class="max-h-72 self-center object-contain"
      />
    ) : (
      item.data.heroImage && (
        <img
          src={item.data.heroImage}
          alt=""
          class="max-h-72 self-center object-contain"
        />
      )
    )}
    <WorkLinks links={item.data.links} />
    <section>
      <h2>直接つながっている要素</h2>
      {neighbors.length === 0 ? (
        <p>関連する要素はまだありません。</p>
      ) : (
        <ul class="flex flex-col gap-s3">
          {neighbors.map(({ id, data }) => (
            <li>
              <a
                href={portfolioUrl(id)}
                class="inline-flex items-center gap-s2"
              >
                {data.title}
              </a>
              {graph.edges
                .filter(
                  ({ data: { source, target } }) =>
                    (source.id === item.id && target.id === id) ||
                    (target.id === item.id && source.id === id),
                )
                .map(({ data }) => (
                  <p class="text-sm">{data.label}</p>
                ))}
            </li>
          ))}
        </ul>
      )}
    </section>
    <section>
      <h2>2ステップ先までの関連</h2>
      <PortfolioGraph {...graph} root={item.id} />
    </section>
  </div>
</Layout>
