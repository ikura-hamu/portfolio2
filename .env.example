# --- Local development (no GitHub required) -------------------------------
# Copy this file to `.env` and the admin UI runs against the working tree with
# authentication bypassed. Both settings are refused in a production build.
ADMIN_BACKEND=local
ADMIN_AUTH=bypass
SESSION_SECRET=change-me-to-at-least-32-random-characters

# --- Production (set these in Vercel) --------------------------------------
# ADMIN_BACKEND and ADMIN_AUTH must be left unset in production.
#
# GitHub OAuth App - identity only, scope `read:user`.
# Authorization callback URL: https://ikura-hamu.work/api/auth/github/callback
# GITHUB_OAUTH_CLIENT_ID=
# GITHUB_OAUTH_CLIENT_SECRET=
#
# GitHub App - `Contents: Read and write`, installed on this repository only.
# The private key is the PEM contents; escaped newlines (\n) are accepted.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_INSTALLATION_ID=
#
# The numeric GitHub user id allowed to use the admin UI. Login names are not
# used: they can be changed, and the freed name re-registered by someone else.
# ALLOWED_GITHUB_USER_ID=
#
# Repository the admin UI writes to, and the branch working branches fork from.
# CONTENT_REPO=ikura-hamu/portfolio2
# CONTENT_BRANCH=main
