---
import { Icon } from "astro-icon/components";

interface Props {
  extraContent: {
    icon: string;
    name: string;
    url: string;
  };
}

const { extraContent } = Astro.props;
---

<style>
  a:hover {
    text-decoration: underline;
    text-decoration-color: white;
  }
</style>

<div class="flex justify-center items-center">
  <a
    href={extraContent.url}
    target="_blank"
    rel="noopener noreferrer"
    class="no-underline flex items-center justify-center my-s5 bg-primary hover:bg-secondary rounded-md min-w-75 max-w-100
      hover:duration-150 hover:underline hover:decoration-white"
  >
    <Icon name={extraContent.icon} class="text-3xl text-accent" />
    <div class="text-base ml-s2 text-white">
      {extraContent.name}で<br />
      もっと見る
    </div>
  </a>
</div>
