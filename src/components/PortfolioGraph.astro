---
import { Icon } from "astro-icon/components";
import {
  forceCollide,
  forceLink,
  forceManyBody,
  forceRadial,
  forceSimulation,
  type SimulationLinkDatum,
  type SimulationNodeDatum,
} from "d3-force";
import {
  portfolioUrl,
  type PortfolioNode,
  type PortfolioRelation,
} from "../lib/portfolioGraph";

interface Props {
  nodes: PortfolioNode[];
  edges: PortfolioRelation[];
  root?: string;
  distance?: Map<string, number>;
}

interface GraphNode extends SimulationNodeDatum {
  id: string;
  hop: number;
}
type GraphLink = SimulationLinkDatum<GraphNode>;

const { nodes, edges, root, distance } = Astro.props;
const nodeWidth = 192;
const nodeSize = 52;
const nodeTop = 92;
const nodeRadius = nodeSize / 2;
const horizontalPadding = nodeWidth / 2 + 10;
const verticalPadding = nodeTop + 4;
const linkDistance = 175;
const graphNodes: GraphNode[] = nodes.map(({ id }) => ({
  id,
  hop: distance?.get(id) ?? 0,
  ...(id === root ? { fx: 0, fy: 0 } : {}),
}));
const graphLinks: GraphLink[] = edges.map(({ data }) => ({
  source: data.source.id,
  target: data.target.id,
}));

// Run the layout during rendering so the links and graph work without browser JavaScript.
forceSimulation(graphNodes)
  .force(
    "links",
    forceLink<GraphNode, GraphLink>(graphLinks)
      .id((node) => node.id)
      .distance(linkDistance)
      .strength(0.3),
  )
  .force("repulsion", forceManyBody().strength(-160))
  .force("collision", forceCollide(nodeWidth / 2).iterations(3))
  .force(
    "radius",
    forceRadial<GraphNode>((node) =>
      root ? node.hop * linkDistance : 0,
    ).strength(root ? 0.35 : 0.055),
  )
  .stop()
  .tick(300);

const positions = new Map(
  graphNodes.map((node) => [node.id, { x: node.x ?? 0, y: node.y ?? 0 }]),
);
const names = new Map(nodes.map(({ id, data }) => [id, data.title]));
const points = Array.from(positions.values());
const xs = points.map(({ x }) => x);
const ys = points.map(({ y }) => y);
const halfWidth = Math.max(0, ...xs.map(Math.abs)) + horizontalPadding;
const halfHeight = Math.max(0, ...ys.map(Math.abs)) + verticalPadding;
const left = root ? -halfWidth : Math.min(0, ...xs) - horizontalPadding;
const right = root ? halfWidth : Math.max(0, ...xs) + horizontalPadding;
const top = root ? -halfHeight : Math.min(0, ...ys) - verticalPadding;
const bottom = root ? halfHeight : Math.max(0, ...ys) + nodeRadius + 10;
const width = right - left;
---

<div class="graph-scroll" role="region" aria-label="関連グラフ" tabindex="0">
  <svg
    viewBox={`${left} ${top} ${width} ${bottom - top}`}
    style={`--graph-min-width: ${Math.min(450, width)}px; --graph-width: ${width}px; --node-size: ${nodeSize}px`}
    class="graph"
    role="group"
    aria-label={
      root
        ? `${names.get(root)}から2ステップ以内の関連グラフ`
        : "Skills・Products・Slides・タグの関連グラフ"
    }
  >
    {edges.map(({ data: { source, target, label } }) => {
      const a = positions.get(source.id)!;
      const b = positions.get(target.id)!;
      return (
        <line x1={a.x} y1={a.y} x2={b.x} y2={b.y}>
          <title>{names.get(source.id)} — {label} — {names.get(target.id)}</title>
        </line>
      );
    })}
    {nodes.map(({ id, data }) => {
      const { x, y } = positions.get(id)!;
      return (
        <foreignObject
          x={x - nodeWidth / 2}
          y={y - nodeTop}
          width={nodeWidth}
          height={nodeTop + nodeRadius}
        >
          <div class="node">
            <a
              href={portfolioUrl(id)}
              aria-current={id === root ? "page" : undefined}
              class:list={[data.category, { current: id === root }]}
            >
              <span class="node-title">{data.title}</span>
              <span class="node-icon">
                <Icon
                  name={
                    data.category === "skills"
                      ? "ri:code-s-slash-line"
                      : data.icon
                  }
                  size={26}
                />
              </span>
            </a>
          </div>
        </foreignObject>
      );
    })}
  </svg>
</div>
<style>
  .graph-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-secondary);
    border-radius: 16px;
  }
  .graph {
    display: block;
    width: 100%;
    min-width: var(--graph-min-width);
    max-width: var(--graph-width);
    margin-inline: auto;
  }
  line {
    stroke: var(--color-secondary);
    stroke-width: 2;
  }
  .node {
    height: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-end;
    pointer-events: none;
  }
  .node-title {
    background: var(--color-background);
    color: inherit;
    font-size: 16px;
    font-weight: 700;
    line-height: 1.2;
    text-align: center;
    padding-inline: 3px;
  }
  .node-icon {
    display: grid;
    place-items: center;
    border-radius: 50%;
    width: var(--node-size);
    height: var(--node-size);
    flex: none;
    background: var(--color-background);
    border: 2px solid currentColor;
    color: var(--node-color);
  }
  a {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    pointer-events: auto;
    color: inherit;
    text-decoration: none;
  }
  a.skills {
    --node-color: #0f71f2;
  }
  a.products {
    --node-color: #16856e;
  }
  a.slides {
    --node-color: #a153be;
  }
  a.tags {
    --node-color: #9d6226;
  }
  a.current .node-icon,
  a:hover .node-icon,
  a:focus-visible .node-icon {
    border-width: 3px;
    box-shadow: 0 0 0 3px color-mix(in srgb, var(--node-color) 25%, transparent);
  }
  foreignObject {
    overflow: visible;
    pointer-events: none;
  }
</style>
