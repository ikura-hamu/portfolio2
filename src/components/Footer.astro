---
import { Icon } from "astro-icon/components";
const today = new Date();
---

<footer>
  &copy; {today.getFullYear()} @ikura-hamu. All rights reserved.
  <div class="social-links">
    <a href="https://twitter.com/ikura_hamu" target="_blank" title="X(Twitter)">
      <span class="sr-only">X @ikura_hamu</span>
      <Icon name="ri:twitter-x-fill" width={32} height={32} />
    </a>
    <a href="https://github.com/ikura-hamu" target="_blank" title="GitHub">
      <span class="sr-only">GitHub @ikura-hamu</span>
      <Icon name="codicon:github-inverted" width={32} height={32} />
    </a>
  </div>
</footer>
<style>
  footer {
    padding: 2em 1em 6em 1em;
    background: linear-gradient(
        var(--color-background),
        color-mix(in srgb, var(--color-secondary) 12%, var(--color-background))
      )
      no-repeat;
    color: inherit;
    text-align: center;
    transition:
      background-color 0.3s ease,
      color 0.3s ease;
  }
  .social-links {
    display: flex;
    justify-content: center;
    gap: 1em;
    margin-top: 1em;
  }
  .social-links a {
    text-decoration: none;
    color: inherit;
    opacity: 0.65;
  }
  .social-links a:hover {
    opacity: 1;
  }
</style>
