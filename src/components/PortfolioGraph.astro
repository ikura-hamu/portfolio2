---
import type { CollectionEntry } from "astro:content";
import { portfolioUrl } from "../lib/portfolioGraph";
interface Props {
  nodes: CollectionEntry<"portfolio">[];
  edges: CollectionEntry<"relation">[];
  root?: string;
  distance?: Map<string, number>;
}
const { nodes, edges, root, distance } = Astro.props;
const groups = root
  ? [0, 1, 2].map((hop) => nodes.filter(({ id }) => distance?.get(id) === hop))
  : ["skills", "products", "slides"].map((category) =>
      nodes
        .filter(({ data }) => data.category === category)
        .sort((a, b) => a.data.order - b.data.order),
    );
const columnWidth = 164;
const rowHeight = 108;
const width = Math.max(2, ...groups.map((group) => group.length)) * columnWidth;
const rows = groups.filter((group) => group.length > 0);
const positions = new Map<string, { x: number; y: number }>();
rows.forEach((group, row) => {
  group.forEach(({ id }, column) => {
    positions.set(id, {
      x: width / 2 + (column - (group.length - 1) / 2) * columnWidth,
      y: (row + 0.5) * rowHeight,
    });
  });
});
const names = new Map(nodes.map(({ id, data }) => [id, data.title]));
---

<div
  class="graph-scroll"
  role="region"
  aria-label="関連グラフ（横にスクロールできます）"
  tabindex="0"
>
  <svg
    viewBox={`0 0 ${width} ${rows.length * rowHeight}`}
    style={`--graph-width: ${width}px`}
    class="graph"
    role="group"
    aria-label={
      root
        ? `${names.get(root)}から2ステップ以内の関連グラフ`
        : "Skills・Products・Slides の関連グラフ"
    }
  >
    <title>要素を選択すると詳細ページに移動します</title>
    {edges.map(({ data: { source, target, label } }) => {
      const a = positions.get(source.id)!;
      const b = positions.get(target.id)!;
      return (
        <line x1={a.x} y1={a.y} x2={b.x} y2={b.y}>
          <title>{names.get(source.id)} — {label} — {names.get(target.id)}</title>
        </line>
      );
    })}
    {nodes.map(({ id, data }) => {
      const position = positions.get(id)!;
      return (
        <a
          href={portfolioUrl(id)}
          aria-label={`${data.title}の詳細`}
          class:list={[{ current: id === root }]}
        >
          <title>{data.title}</title>
          <rect
            x={position.x - 76}
            y={position.y - 24}
            width="152"
            height="48"
            rx="12"
          />
          <text
            x={position.x}
            y={position.y}
            dominant-baseline="central"
            text-anchor="middle"
          >
            {data.title.length > 11
              ? `${data.title.slice(0, 10)}…`
              : data.title}
          </text>
        </a>
      );
    })}
  </svg>
</div>
<p class="text-sm">
  線は要素同士の関係を表します。各要素を選択して、関連をたどれます。
</p>
<style>
  .graph-scroll {
    overflow-x: auto;
    border: 1px solid var(--color-secondary);
    border-radius: 16px;
  }
  .graph {
    display: block;
    width: var(--graph-width);
    margin-inline: auto;
  }
  line {
    stroke: var(--color-secondary);
    stroke-width: 2;
  }
  rect {
    fill: var(--color-background);
    stroke: var(--color-secondary);
    stroke-width: 2;
  }
  text {
    fill: currentColor;
    font-size: 13px;
    font-weight: 700;
  }
  .current rect {
    stroke: var(--color-primary);
    stroke-width: 4;
  }
  a:hover rect,
  a:focus rect {
    stroke: var(--color-primary);
    stroke-width: 4;
  }
</style>
