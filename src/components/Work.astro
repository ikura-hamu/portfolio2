---
import { getCollection } from "astro:content";
import { Icon } from "astro-icon/components";
import { Image } from "astro:assets";

import { replaceURL } from "@/util/url";
import { portfolioUrl } from "../lib/portfolioGraph";
import ViewMoreButton from "./ViewMoreButton.astro";
import WorkLinks from "./WorkLinks.astro";

interface Props {
  workType: "products" | "slides";
  extraContent?: {
    icon: string;
    name: string;
    url: string;
  };
}

const { workType, extraContent } = Astro.props;
const works = (
  await getCollection("portfolio", ({ data }) => data.category === workType)
).sort((a, b) => a.data.order - b.data.order);
---

<div class="flex flex-col gap-s4">
  <div class="grid grid-cols-[repeat(auto-fill,minmax(300px,1fr))] gap-x-s4 gap-y-s5 work-grid">
    {works.map(({ id, data: work }) => (
      <div class="flex flex-col rounded-md min-w-75 max-w-full p-s2 gap-s1 work-card">
        <a
          href={portfolioUrl(id)}
          class="hover:duration-150 rounded-md p-s1 work-link flex flex-col gap-s1 work-link"
        >
          <div class="flex justify-center h-32 overflow-hidden">
            {work.heroImageContent ? (
              <Image
                src={work.heroImageContent}
                alt={work.title}
                class="object-contain h-full w-full"
              />
            ) : (
              <img
                src={work.heroImage ?? "/favicon.png"}
                alt={work.title}
                class="object-contain h-full w-full"
              />
            )}
          </div>

          <h5 class="truncate" title={work.title}>
            <div class="inline">{work.title}</div>
            <Icon name="ri:arrow-right-line" class="inline ml-s1 text-xs" />
          </h5>

          {work.subtitle && (
            <div class="leading-tight text-sm">{work.subtitle}</div>
          )}
        </a>

        <div class="flex gap-s2">
          {work.tags.map((tag) => (
            <div class="text-sm bg-accent dark:text-black rounded-md px-s2">
              #{tag}
            </div>
          ))}
        </div>

        <div class="text-base" set:html={replaceURL(work.description)} />

        <WorkLinks links={work.links} class="mt-auto" />
      </div>
    ))}
  </div>

  {extraContent && (
    <ViewMoreButton
      extraContent={{
        icon: extraContent.icon,
        name: extraContent.name,
        url: extraContent.url,
      }}
    />
  )}
</div>

<style>
  .work-grid {
    container-name: work-grid;
    container-type: inline-size;
  }

  .work-card {
    transition: border-color 0.3s ease;
  }

  .work-link :global(img) {
    transition: transform 0.2s ease;
  }

  .work-link:hover :global(img) {
    transform: scale(1.05);
  }

  @container work-grid (max-width: 615px) {
    .work-card {
      position: relative;
    }

    .work-card:not(:last-child)::after {
      content: "";
      position: absolute;
      right: 0;
      bottom: -13px;
      left: 0;
      border-bottom: 1px dotted var(--color-secondary);
    }
  }
</style>
